DIMENSIONS ntax=31;
TAXLABELS
	[1] 'Chloraea'
	[2] 'Vanilla'
	[3] 'Apostasia'
	[4] 'Phragmipedium'
	[5] 'Cypripedium'
	[6] 'Thelymitra'
