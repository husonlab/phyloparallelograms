#nexus [SplitsTree6]

BEGIN SPLITSTREE6;
DIMENSIONS nDataNodes=8 nAlgorithms=6;
PROGRAM version='SplitsTree App (version 6.7.9, built 25 May 2026)';
WORKFLOW creationDate='1782387839396'; [Thu Jun 25 13:43:59 CEST 2026]
END; [SPLITSTREE6]

BEGIN TAXA;
TITLE 'Input Taxa';
LINK ALGORITHM = 'Input Data Loader';
DIMENSIONS ntax=0;
TAXLABELS
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN ALGORITHM;
TITLE 'Taxa Filter';
LINK ALGORITHM = 'Input Data Loader';
NAME 'Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN TAXA;
TITLE 'Working Taxa';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS ntax=0;
TAXLABELS
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN TREES;
TITLE 'Input Trees';
LINK ALGORITHM = 'Input Data Loader';
TRANSLATE
;
[TREES]
END; [TREES]

BEGIN ALGORITHM;
TITLE 'Input Data Filter';
LINK TREES = 'Input Trees';
NAME 'Trees Taxa Filter';
END; [ALGORITHM]

BEGIN TREES;
TITLE 'Working Trees';
LINK ALGORITHM = 'Input Data Filter';
TRANSLATE
;
[TREES]
END; [TREES]

BEGIN ALGORITHM;
TITLE 'Show Trees';
LINK TREES = 'Working Trees';
NAME 'Show Trees';
OPTIONS
	View = 'Tanglegram';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Phylo Fusion';
LINK TREES = 'Working Trees';
NAME 'Phylo Fusion';
OPTIONS
	OnlyOneNetwork = 'false',
	MutualRefinement = 'false',
	MissingTaxaHeuristic = 'false',
	NormalizeEdgeWeights = 'true',
	GroupNonSeparated = 'false',
	CladeReduction = 'false';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'Tanglegram';
LINK ALGORITHM = 'Show Trees';
NAME 'ViewView';
INPUT 'TREES';
END; [VIEW]

BEGIN TREES;
TITLE 'Trees';
LINK ALGORITHM = 'Phylo Fusion';
TRANSLATE
;
[TREES]
END; [TREES]

BEGIN ALGORITHM;
TITLE 'Show Trees-2';
LINK TREES = 'Trees';
NAME 'Show Trees';
OPTIONS
	View = 'TreeView';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'TreeView';
LINK ALGORITHM = 'Show Trees-2';
NAME 'ViewView';
INPUT 'TREES';
END; [VIEW]
